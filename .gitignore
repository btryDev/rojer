# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# Sortie de `pnpm dev` redirigée : un journal local, jamais versionné.
dev.log

# Claude Code runtime
.claude/scheduled_tasks.lock

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local file storage (dev only) — rapports de vérification uploadés
/storage


# Exports Claude Design déposés à la racine — références de travail.
/Tableau de bord Rojer.html

# Planches Claude Design (canvas `.dc.html` + build) — travail de conception,
# pas du produit. Le rendu final pèse plusieurs mégaoctets et se régénère
# depuis `build.py` : le garder ici alourdirait le dépôt sans rien y ajouter.
# Ignoré explicitement pour qu'un `git add -A` ne l'emporte pas au passage.
/.design-encart/

# Worktrees Claude Code (dépôts imbriqués, hors dépôt principal)
.claude/worktrees/

# Surcharges Compose locales — ports d'une machine, jamais du dépôt.
# Un port hôte est propre au poste : sur une machine où 5433 est déjà pris,
# on le déplace ici plutôt que d'arrêter le conteneur d'un autre projet.
# Attention au tag `!override` sur `ports` : sans lui, Compose AJOUTE le port
# à la liste du fichier de base au lieu de la remplacer, et le conflit revient.
docker-compose.override.yml

# Sorties du script de relecture : régénérables à la demande, jamais suivies.
# Un fichier nommé « --detail » vient d'une version du script qui lisait
# argv[2] sans filtrer les options ; son nom le rend hostile à la plupart des
# outils en ligne de commande.
/--detail
Rojer-*.pdf

# Journal de l'étalement des dossiers de démo : l'état d'une base, pas du code.
# Le script qui l'écrivait est retiré (2026-09-18, ADR-036 lot 3) ; l'entrée
# reste tant qu'un journal ancien peut traîner sur une machine.
/scripts/.etalement/

# Export du passage à blanc (ADR-036, lot 2c) : l'état des calendriers d'une
# base à un instant, dates et identifiants — jamais du code, et la commande
# documentée l'écrit à la racine. Le script le projette pour qu'aucun nom n'y
# figure ; il n'a pas sa place dans le dépôt pour autant.
/passage-a-blanc-*.json
