generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // En prod (Supabase) : URL via pooler PgBouncer (port 6543) pour le runtime.
  url       = env("DATABASE_URL")
  // URL directe (port 5432) pour les migrations — Prisma Migrate a besoin
  // de prepared statements que PgBouncer ne supporte pas en mode transaction.
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// V2 — Plateforme de conformité santé-sécurité continue
// Modèle documenté dans /docs/adr/001 à 004.
// ============================================================================

// ADR-005 : Entreprise est rattachée à un user Supabase (auth.users.id).
// userId est un UUID stocké en texte, pas de FK cross-schéma : auth.* est
// géré par Supabase, on n'y projette pas de contrainte Prisma. Le scoping
// par user est assuré au niveau applicatif (helper requireUser + WHERE userId).
//
// Invariant produit « 1 utilisateur = 1 entreprise » : jusqu'ici il n'était
// affirmé que par des findFirst applicatifs, non atomiques. Il est désormais
// porté par la base (@unique sur userId). Postgres considère les NULL comme
// distincts : plusieurs entreprises sans utilisateur rattaché restent possibles,
// ce qui est voulu (données de démo, entreprise créée avant l'auth).

model Entreprise {
  id             String          @id @default(cuid())
  userId         String?         @unique @db.Uuid
  raisonSociale  String
  siret          String?
  codeNaf        String
  effectif       Int
  adresse        String
  etablissements Etablissement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// ADR-001 : Etablissement est l'ancrage des obligations réglementaires.
// ADR-004 : régimes cumulables (travail / ERP / IGH / habitation) via flags.
//
// ADR-028 (2026-09-01) : une entreprise porte autant d'établissements qu'elle
// en a. Le @unique qui tenait ici l'invariant « 1 entreprise = 1 établissement »
// est retiré par la migration `20260901130000_multi_etablissements`, qui repose
// l'index simple à sa place. La marche de sortie annoncée à cet endroit a tenu
// mot pour mot : aucun helper de `src/lib/auth/scope.ts` n'a eu à être réécrit,
// parce qu'ils bornent tous par `entreprise.userId` en prenant un identifiant
// explicite. La relation inverse était déjà typée en liste, elle porte
// désormais ce qu'elle annonçait.
//
// Ce qui ne bouge pas : `Entreprise.userId` reste @unique. Un compte reste une
// entreprise — racine de tenancy de l'ADR-005 —, et le multi-utilisateur reste
// hors roadmap.
//
// Ce que le retrait déplace, en revanche : « l'établissement du compte » cesse
// d'être une notion définie. Partout où le code en désignait un sans avoir à le
// nommer, il désigne maintenant l'établissement ACTIF — cookie
// `etablissement-actif`, cf. `getOptionalUserEtablissement` —, et le serveur MCP
// ne choisit plus à la place du porteur (cf. `src/lib/mcp/acces-oauth.ts`).
model Etablissement {
  id           String     @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  raisonDisplay   String
  adresse         String
  codeNaf         String?
  effectifSurSite Int

  // Régimes — cf. ADR-004
  estEtablissementTravail Boolean       @default(true)
  estERP                  Boolean       @default(false)
  estIGH                  Boolean       @default(false)
  estHabitation           Boolean       @default(false)
  typeErp                 TypeErp?
  categorieErp            CategorieErp?
  classeIgh               ClasseIgh?
  // Famille au sens de l'arrêté du 31 janvier 1986 (ADR-025 § 4). Nullable
  // comme `categorieErp` : la contrainte « obligatoire si le régime est
  // déclaré » vit dans les schémas de création, pas dans la colonne — les
  // dossiers d'habitation créés avant le 2026-09-01 n'en ont pas, et ils
  // continuent d'exister. Ce qu'ils portent à la place est une indétermination
  // visible, pas une valeur inventée.
  familleHabitation       FamilleHabitation?

  // « Cet établissement comporte-t-il, POUR LE PUBLIC, des locaux à sommeil ? »
  // — chambres d'hôtel, chambres d'hôtes, hébergement. C'est un fait
  // d'ÉTABLISSEMENT, et il a mis six jours à trouver sa colonne : la
  // restriction vivait jusqu'ici sur une caractéristique d'alarme
  // (`dessertLocauxSommeil`), c'est-à-dire sur un équipement qu'un hôtel n'a
  // pas forcément déclaré. Quatre articles du Livre III de l'arrêté du
  // 25 juin 1980 s'y adossent : PE 4 § 1, PE 33, PE 35 et PE 37.
  //
  // NULLABLE, ET `null` VEUT DIRE « PAS ENCORE RÉPONDU », JAMAIS « NON »
  // (règle du non-renseigné, `.claude/CLAUDE.md`). Un `@default(false)` aurait
  // répondu « je n'ai pas de chambres » à la place d'un hôtelier qui n'a rien
  // lu, et lui aurait retiré en silence la visite de commission quinquennale.
  // Le moteur retient donc l'obligation tant que la réponse manque, en disant
  // « à confirmer » (cf. `evaluerLocauxSommeil`, `matching/engine.ts`).
  //
  // Aucune reprise de données : les réponses déjà données à
  // `dessertLocauxSommeil` ne sont PAS recopiées ici. « Cette alarme dessert
  // des locaux à sommeil » et « l'établissement comporte des locaux à sommeil
  // pour le public » ne sont pas la même question — la première ne distingue
  // pas le sommeil du public de celui du personnel, et une alarme peut ne pas
  // desservir des chambres qui existent. Cf. migration 20260901180000.
  comporteLocauxSommeilPublic Boolean?

  batiments                        Batiment[]
  // Champ d'application de R. 4227-34 CT (alarme sonore → consigne R. 4227-37
  // → exercices semestriels R. 4227-39) : « plus de cinquante personnes
  // occupées ou réunies habituellement » — public compris, pas seulement les
  // salariés — « ainsi que ceux, quelle que soit leur importance, où sont
  // manipulées et mises en œuvre des matières inflammables mentionnées à
  // l'article R. 4227-22 ». `null` = non renseigné : le moteur retombe sur
  // `effectifSurSite` (sous-estimation assumée) et sur « non » pour les
  // matières. Cf. migration 20260825120000.
  personnesPresentesHabituellement Int?
  manipuleMatieresR422722          Boolean?

  // Renseignements portés par la fiche « Renseignements généraux » du registre
  // de sécurité (CCH R. 143-44). Ils vivent ici et non dans `FicheRegistre` :
  // ce sont des faits d'établissement, et la fiche établissement les montre
  // aussi. Deux emplacements pour la même donnée finiraient par diverger, et
  // c'est le registre — celui qu'on présente à la commission — qui
  // afficherait la valeur périmée.
  //
  // `natureActivite` : l'activité en clair, distincte du code NAF.
  // Les trois autres ne valent que pour un ERP ; nullables, comme
  // `typeErp`/`categorieErp` (ADR-004).
  natureActivite            String?
  effectifPublicAdmis       Int?
  dateAutorisationOuverture DateTime?
  dateCertificatConformite  DateTime?

  // Deux questions de paramétrage (ADR-025 § 7, ADR-032). Les trois colonnes
  // sont nullables et `null` veut dire « pas encore répondu » — jamais « non ».
  // Un `@default(false)` aurait répondu à la place du dirigeant, et la
  // checklist du tableau de bord aurait coché une question que personne n'a
  // lue : les prédicats testent donc la présence d'une réponse, pas sa valeur.
  //
  // `aDemandesAssureur` n'a AUCUN effet sur le moteur : il ouvre une porte de
  // saisie vers une prescription particulière de source `demande_assureur`,
  // et ce sont les prescriptions saisies qui font naître des échéances.
  //
  // `epiPresents` / `epiPresentsDetail` sont une consignation, et rien n'en
  // dérive. R. 4323-95 à R. 4323-106 CT et l'arrêté du 19 mars 1993 n'ont
  // jamais été ouverts dans ce dépôt, et c'est un guide commercial — non une
  // source — qui a fait croire à une périodicité annuelle générale des EPI.
  // Lire avant d'encoder : aucune obligation, aucune périodicité ici.
  // Le détail est un texte libre exprès ; figer un enum de nomenclature
  // maintenant trancherait par accident une question qu'on n'a pas instruite.
  epiPresents               Boolean?
  epiPresentsDetail         String?
  aDemandesAssureur         Boolean?

  duerps                     Duerp[]
  equipements                Equipement[]
  verifications              Verification[]
  rapports                   RapportVerification[]
  actions                    Action[]
  prestataires               Prestataire[]
  signatures                 Signature[]
  accessTokens               AccessToken[]
  registreAccessibilite      RegistreAccessibilite?
  permisFeu                  PermisFeu[]
  plansPrevention            PlanPrevention[]
  carnetSanitaire            CarnetSanitaire?
  interventions              Intervention[]
  prescriptionsParticulieres PrescriptionParticuliere[]
  fichesRegistre             FicheRegistre[]
  salaries                   Salarie[]
  etatsDeclares              DeclarationEtatPermanent[]

  /**
   * Version du référentiel de conformité avec laquelle le calendrier de cet
   * établissement a été généré (cf. `REFERENTIEL_VERSION`, ADR-003).
   * Le référentiel vit en TypeScript versionné, mais ses effets sont écrits en
   * base : chaque `Verification` fige une périodicité et un libellé. Sans ce
   * repère, une correction du référentiel — périodicité rectifiée, obligation
   * retirée — ne se propageait qu'au hasard d'une mutation d'équipement, et une
   * obligation supprimée laissait des lignes orphelines invisibles des filtres.
   * `null` = calendrier jamais réconcilié depuis l'introduction du mécanisme :
   * il sera réaligné au prochain affichage.
   */
  referentielVersionCalendrier String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // L'index que l'unicité avait remplacé, et qu'elle rend en partant : lister
  // les établissements d'un compte est désormais une lecture de chaque rendu du
  // sélecteur, pas une curiosité (ADR-028).
  @@index([entrepriseId])
}

enum TypeErp {
  M
  N
  O
  L
  P
  R
  S
  T
  U
  V
  W
  X
  Y
  // Structures d'accueil pour personnes âgées et personnes handicapées.
  // Entré le 2026-09-03, et il manquait depuis l'origine : l'ADR-004 avait
  // écrit la liste de mémoire — « (~20 valeurs) » — sans jamais la confronter
  // à l'article GN 1 de l'arrêté du 25 juin 1980, qui en compte vingt-deux.
  // Un EHPAD ne pouvait pas se déclarer pour ce qu'il est, alors que le
  // tableau de GE 4 § 1 lui donne une colonne à part entière.
  //
  // Placé ICI et non en tête : GN 1 § 1 ouvre sa liste par J, mais il la
  // divise aussi en deux groupes — a) établissements installés dans un
  // bâtiment, b) établissements spéciaux —, et c'est ce découpage-là que
  // l'ordre de l'enum reproduit. J ferme donc le groupe a), juste avant PA
  // qui ouvre le groupe b). L'ordre gouverne l'affichage du sélecteur de type
  // du formulaire ; le reproduire à l'identique en base évite qu'il diverge
  // de `TYPES_ERP` et de `TYPE_ERP`.
  //
  // L'ordre de l'énumération n'est PAS celui du texte pour autant, et aucun
  // test ne le prétend : à l'intérieur de chaque groupe, la liste du produit
  // met en avant les types des secteurs cibles (M, N, O). C'est un choix
  // d'affichage, pas une lecture du texte, et le test `types-erp.test.ts`
  // compare donc les deux listes comme des ENSEMBLES.
  J
  PA
  CTS
  SG
  PS
  REF
  GA
  OA
  EF
}

enum CategorieErp {
  N1
  N2
  N3
  N4
  N5
}

// Familles d'habitation de l'arrêté du 31 janvier 1986. La 3ᵉ famille se
// scinde en 3A et 3B — la distinction porte sur la desserte par la voie
// échelle, et elle change les obligations : les séparer dès l'enum évite
// d'avoir à la rattraper plus tard sur des données déjà saisies.
enum FamilleHabitation {
  PREMIERE
  DEUXIEME
  TROISIEME_A
  TROISIEME_B
  QUATRIEME
}

// Classes d'immeubles de grande hauteur — CCH, art. R. 146-4.
//
// LE TEXTE EN ÉCRIT DIX ; CETTE ÉNUMÉRATION EN PORTE ONZE, ET LA ONZIÈME EST
// EN SURSIS. Jusqu'au 2026-09-03 la liste était tirée de l'arrêté du
// 30 décembre 2011, qui ne la porte pas — son `GH 1` renvoie au code, et son
// titre III groupe GH W 1 et GH W 2 sous un chapitre unique « GH W ». Un
// chapitre de règlement n'est pas une classe : le code n'écrit nulle part de
// classe « GHW », et `GHTC` (tour de contrôle) manquait purement et
// simplement.
//
// La hauteur du plancher bas est le seul fait qui sépare GHW1 (plus de 28 m,
// au plus 50 m) de GHW2 (plus de 50 m) — les fusionner en « GHW » revenait à
// ne jamais la demander.
//
// POURQUOI `GHW` EST ENCORE LÀ. Le retrait d'une valeur d'énumération
// PostgreSQL réécrit la colonne, et les lignes qui portent `GHW` n'ont pas
// d'équivalent : `GHW` ne dit pas si la tour fait 40 ou 60 mètres. On ne sait
// pas s'il en existe — la lecture de la base de production n'a pas pu être
// faite —, et `pnpm build` joue `prisma migrate deploy` : pousser le retrait
// reviendrait à effacer une donnée sans savoir laquelle. La valeur reste donc
// dans le TYPE, mais elle a disparu de tous les CHOIX offerts
// (`src/lib/etablissements/schema.ts`, `CHOIX_CLASSES_IGH`, le formulaire) :
// plus personne ne peut en créer, et un dossier qui en porte une continue de
// l'afficher. Le comptage devient concluant une fois ce palier déployé.
//
// Retrait au temps 2, condition et marche à suivre écrites dans
// `docs/chantiers-ouverts.md` § 9 bis. `src/lib/referentiels/classes-igh.test.ts`
// dérive la liste du verbatim de R. 146-4 dépouillé au corpus, et ne tolère
// `GHW` que par une dérogation nommée qui ne peut que rétrécir.
enum ClasseIgh {
  GHA
  GHO
  GHR
  GHS
  GHTC
  GHU
  GHW // EN SURSIS — absente de R. 146-4, retrait au temps 2. Ne pas réoffrir.
  GHW1
  GHW2
  GHZ
  ITGH
}

// ----------------------------------------------------------------------------
// Module DUERP — existant, rattaché à Etablissement
//
// CONSERVATION 40 ANS (art. R. 4121-4 CT, cf. docs/rgpd.md) : une DuerpVersion
// figée est une pièce à valeur légale, elle ne peut pas être détruite par un
// effet de bord. La chaîne Etablissement → Duerp → DuerpVersion était en
// cascade complète : supprimer un établissement effaçait silencieusement toutes
// les versions archivées.
//
// Le garde-fou porte donc sur le SEUL maillon qui porte la preuve :
// `DuerpVersion.duerp` est en `Restrict`. Tant qu'une version figée existe, la
// base REFUSE la suppression — et comme `Duerp.etablissement` est en `Cascade`,
// ce refus remonte toute la chaîne : supprimer l'établissement (ou l'entreprise)
// tente de cascader sur le Duerp, le `Restrict` de DuerpVersion s'y oppose, et
// toute la transaction est annulée. Rien n'est perdu.
//
// `Duerp.etablissement` a lui-même été en `Restrict` un temps : c'était trop
// large. Un DUERP ouvert mais jamais validé ne porte aucune obligation de
// conservation ; le mettre en `Restrict` rendait tout établissement indélébile
// dès qu'on avait cliqué une fois sur « Commencer mon DUERP », sans aucun motif
// légal. Un garde-fou doit être exactement aussi large que l'obligation qu'il
// sert (cf. ADR-012, section C).
//
// Conséquence pour l'applicatif : `prisma.etablissement.delete` et
// `prisma.entreprise.delete` peuvent lever P2003 (violation de clé étrangère)
// quand — et seulement quand — une version figée existe. Les server actions
// traduisent ce refus en message explicite et orientent l'utilisateur vers
// l'export de ses versions avant suppression.
// ----------------------------------------------------------------------------

model Duerp {
  id                            String         @id @default(cuid())
  // Invariant produit « 1 établissement = 1 DUERP » : sans lui, chaque module
  // choisissait un DUERP différent (createdAt desc / updatedAt desc / aucun tri)
  // et le tableau de bord pouvait lire un document pendant que le wizard éditait
  // l'autre. Comme pour Etablissement, la relation inverse reste une liste :
  // `etablissement.duerps[0]` continue de fonctionner, la base garantit
  // désormais qu'il n'y a rien après l'index 0.
  etablissementId               String         @unique
  // Cascade — cf. bloc de conservation ci-dessus : un DUERP sans version figée
  // ne se conserve pas, c'est `DuerpVersion.duerp` (Restrict) qui bloque.
  etablissement                 Etablissement  @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  versions                      DuerpVersion[]
  unites                        UniteTravail[]
  referentielSecteurId          String?
  transversesRepondues          Boolean        @default(false)
  // Réponses aux questions d'activités que le référentiel sectoriel retenu ne
  // couvre pas (ADR-020). Forme : `Record<string, boolean>`, la clé étant l'id
  // d'une `ActiviteNonCouverte` du référentiel TypeScript.
  //
  // Un JSON et non une colonne par activité, ni une table de réponses : la
  // liste des activités vit dans le référentiel versionné (ADR-003), elle
  // change à chaque instruction d'un secteur et ne doit rien coûter en
  // migration. Aucune contrainte d'intégrité n'est perdue au passage — une
  // clé inconnue du référentiel courant est simplement ignorée à la lecture.
  //
  // **Trois états, pas deux.** `NULL` = aucune question n'a jamais reçu de
  // réponse ; clé absente = cette question-là n'a pas reçu de réponse ; clé à
  // `false` = réponse « non » délibérée. Le silence ne doit jamais prendre
  // l'apparence d'un « non » : c'est la même règle que `referentielUniteId`
  // côté unités, et elle vaut ici pour la même raison — ce qui est écrit dans
  // une version validée est relu tel quel pendant quarante ans.
  reponsesActivitesNonCouvertes Json?
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt
}

model DuerpVersion {
  id        String   @id @default(cuid())
  duerpId   String
  // Restrict — cf. bloc de conservation 40 ans ci-dessus.
  duerp     Duerp    @relation(fields: [duerpId], references: [id], onDelete: Restrict)
  numero    Int
  snapshot  Json
  pdfUrl    String?
  motif     String?
  createdAt DateTime @default(now())

  @@unique([duerpId, numero])
}

model UniteTravail {
  id                 String   @id @default(cuid())
  duerpId            String
  duerp              Duerp    @relation(fields: [duerpId], references: [id], onDelete: Cascade)
  nom                String
  description        String?
  referentielUniteId String?
  estTransverse      Boolean  @default(false)
  aucunRisqueJustif  String?
  risques            Risque[]

  // Clé étrangère sans index jusqu'ici : scan séquentiel à chaque construction
  // de snapshot et à chaque cascade partant du DUERP.
  @@index([duerpId])
}

model Risque {
  id                    String         @id @default(cuid())
  uniteId               String
  unite                 UniteTravail   @relation(fields: [uniteId], references: [id], onDelete: Cascade)
  referentielId         String?
  libelle               String
  description           String?
  gravite               Int
  probabilite           Int
  maitrise              Int
  criticite             Int
  cotationSaisie        Boolean        @default(false)
  nombreSalariesExposes Int?
  dateMesuresPhysiques  DateTime?
  exposeCMR             Boolean        @default(false)
  actions               Action[]
  interventions         Intervention[]

  @@unique([uniteId, referentielId])
}

// ----------------------------------------------------------------------------
// Module Conformité — nouveau V2
// ----------------------------------------------------------------------------

// ADR-019 : le bâtiment est un **lieu**, jamais un régime. Les flags ERP/IGH
// et la catégorie restent sur `Etablissement` — le classement ERP s'attache à
// un ensemble de bâtiments non isolés, pas à chaque corps ; le poser ici
// sous-catégoriserait un ERP contigu. Tout établissement en a au moins un,
// ordre 0, créé par la migration puis à la création d'établissement ;
// l'interface reste muette tant qu'il est seul.
//
// ADR-029 : ce modèle s'appelle « zone » à l'écran, et il n'y en a plus que
// trois au plus. La table garde son nom parce que la zone *est* ce bâtiment —
// la renommer n'aurait produit qu'une migration et quatre clés étrangères à
// déplacer. Le plafond vit dans `creerBatiment`, pas ici : une contrainte de
// base aurait rendu immodifiables les dossiers qui portent déjà davantage de
// lieux. Le nom semé est passé de « Bâtiment principal » à « Zone
// principale » ; les lignes existantes gardent le leur, aucune migration ne
// les touche.
model Batiment {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  nom               String
  complementAdresse String?
  ordre             Int     @default(0)

  equipements     Equipement[]
  pointsReleve    PointReleve[]
  permisFeu       PermisFeu[]
  plansPrevention PlanPrevention[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([etablissementId, nom])
  @@index([etablissementId, ordre])
}

model Equipement {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  // Requis, et `Restrict` : supprimer un bâtiment ne doit jamais emporter un
  // équipement et, par cascade, ses vérifications et rapports (ADR-012). On
  // déplace les équipements d'abord. `localisation` reste la précision
  // (salle, étage) à l'intérieur du bâtiment.
  batimentId      String
  // NoAction et non Restrict : même garantie (on ne supprime pas un bâtiment
  // qui contient un équipement), mais vérifiée en fin d'instruction. En
  // Restrict, la cascade de suppression d'un établissement pouvait s'auto-
  // bloquer selon l'ordre des triggers RI. Cf. migration _batiment_fk_no_action.
  batiment        Batiment      @relation(fields: [batimentId], references: [id], onDelete: NoAction)

  categorie         CategorieEquipement
  libelle           String
  localisation      String?
  dateMiseEnService DateTime?
  caracteristiques  Json?
  actif             Boolean             @default(true)

  verifications              Verification[]
  prescriptionsParticulieres PrescriptionParticuliere[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([etablissementId, categorie])
  @@index([batimentId])
}

enum CategorieEquipement {
  INSTALLATION_ELECTRIQUE
  EXTINCTEUR
  RIA
  BAES
  ALARME_INCENDIE
  DESENFUMAGE
  VMC
  CTA
  HOTTE_PRO
  APPAREIL_CUISSON_ERP
  ASCENSEUR
  PORTE_AUTO
  PORTAIL_AUTO
  EQUIPEMENT_SOUS_PRESSION
  STOCKAGE_MATIERE_DANGEREUSE
  EQUIPEMENT_LEVAGE
  INSTALLATION_FRIGORIFIQUE
  COMPACTEUR_PRESSE_DECHETS_MOTORISE
  // Famille, pas régime : un harnais antichute se vérifie, un casque non.
  // Aucune obligation n'y est rattachée tant que R. 4323-95 à -99 et l'arrêté
  // qui fixe la liste des EPI vérifiables n'ont pas été dépouillés — et le
  // dépouillement dira peut-être de la scinder. Voir la migration
  // 20260904120000_categorie_epi.
  EPI
  AUTRE
}

model Verification {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  // `null` = l'échéance est portée par l'établissement lui-même et non par un
  // appareil (ADR-022). Deux articles en vigueur l'imposent : `PE 4 § 2`, dû
  // via `PE 2 § 3` par les établissements qui ont le moins déclaré, et
  // `R. 4222-20`, qui vise tout employeur. Les accrocher à un équipement
  // arbitraire les faisait disparaître en silence chez qui ne l'avait pas
  // déclaré.
  equipementId    String?
  equipement      Equipement?   @relation(fields: [equipementId], references: [id], onDelete: Cascade)

  // Porteur salarié (ADR-023). `equipementId` et `salarieId` ne peuvent pas
  // être renseignés ensemble : une ligne a UN porteur. La contrainte n'est pas
  // exprimable en Prisma — c'est un CHECK, comme le XOR d'origine des actions
  // (ADR-002) — et vit dans le SQL de la migration `porteur_salarie`, sous le
  // nom `Verification_porteur_xor`. `migrations-contraintes.test.ts` la garde.
  //
  // Les deux nuls ensemble restent valides : c'est le porteur établissement.
  // La sémantique n'est donc plus binaire mais ternaire, et c'est pour cela
  // qu'une colonne était nécessaire — on ne pouvait pas surcharger le `null`
  // d'`equipementId`, qui signifiait déjà « établissement ».
  salarieId String?
  // `Restrict`, PAS `Cascade` (ADR-023, corrigé en relecture).
  //
  // En cascade, supprimer un salarié détruisait ses échéances — y compris
  // celles portant un rapport ou une action, c'est-à-dire la PREUVE qu'il était
  // habilité au moment où il a opéré. La suppression contournait entièrement
  // `porteUnePreuve` et toute la logique de conservation de l'ADR-012 : la base
  // n'a pas de raison de refuser ce qu'aucune contrainte ne lui interdit.
  //
  // C'est le même garde-fou que `DuerpVersion.duerp`, et la même forme : la
  // base refuse, et le produit offre la sortie prévue — un salarié qui part est
  // DÉSACTIVÉ (`actif: false`), pas supprimé. Ses titres restent le temps de
  // leur conservation (docs/rgpd.md § 4.3), puis il devient supprimable.
  salarie   Salarie? @relation(fields: [salarieId], references: [id], onDelete: Restrict)

  obligationId      String
  libelleObligation String
  periodicite       Periodicite
  realisateurRequis Realisateur[]

  // Version du référentiel de conformité (ADR-003 : le référentiel vit en
  // TypeScript versionné, pas en base) avec laquelle cette ligne a été générée
  // ou réalignée pour la dernière fois.
  //
  // Sans cette colonne, une évolution du référentiel passe inaperçue : les
  // lignes déjà en base gardent l'ancienne périodicité, et une obligation
  // retirée rend la ligne orpheline — `obligationParId()` renvoie `undefined`,
  // le domaine devient `null`, et la ligne disparaît silencieusement des filtres
  // du registre et du dossier PDF sans que rien ne le signale. Cas vécu : l'id
  // `aeration-hotte-pro-annuelle` a été retiré (fusion d'un doublon) et les
  // vérifications qui le portaient ont survécu.
  //
  // `null` = ligne écrite avant l'introduction du suivi de version : à traiter
  // comme périmée, donc à resynchroniser. La resynchronisation elle-même n'est
  // pas portée ici : cette colonne est la donnée dont elle a besoin.
  referentielVersion String?

  // Prescription particulière (ADR-014) à l'origine de la périodicité de
  // cette ligne (effet `renforce_periodicite`) ou de la ligne elle-même
  // (effet `obligation_sur_mesure`, `obligationId` = "prescription:<id>").
  // `null` = ligne issue du seul référentiel.
  prescriptionId String?
  prescription   PrescriptionParticuliere? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)

  datePrevue   DateTime
  dateRealisee DateTime?
  statut       StatutVerification @default(a_planifier)

  rapports RapportVerification[]
  actions  Action[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Clé d'idempotence du calendrier. Le générateur produit déjà une
  // `cleUnique` « obligationId::equipementId » (lib/calendrier/generateur.ts)
  // qui n'était jamais matérialisée : la régénération procédait donc par
  // delete + create, ce qui détruisait l'historique et les rapports liés.
  // Avec cette contrainte, la régénération devient un upsert sur le triplet.
  // etablissementId est inclus bien qu'il soit déductible de equipementId :
  // il rend la clé utilisable directement dans un `where` scopé par
  // établissement, sans jointure.
  //
  // ATTENTION — la clause `NULLS NOT DISTINCT` de cet index n'est PAS
  // exprimable en Prisma. `equipementId` étant devenu nullable (ADR-022), un
  // index unique ordinaire ne contraindrait plus les lignes portées par
  // l'établissement : en PostgreSQL, deux `NULL` ne se conflictent pas, et le
  // même couple (établissement, obligation) s'insérerait à chaque
  // régénération du calendrier — une ligne de plus par ouverture de page.
  //
  // La migration `porteur_etablissement` remplace donc l'index par un
  // `CREATE UNIQUE INDEX … NULLS NOT DISTINCT` **portant le même nom**
  // (PostgreSQL >= 15 ; la production est en 17.6). `@@unique` est conservé
  // ici pour deux raisons : le client garde le `where` composé, et
  // `prisma migrate diff` compare nom, colonnes et unicité — il voit donc un
  // index conforme, sans dérive. Ce que Prisma ne voit pas, c'est la clause
  // elle-même : un `prisma db push` la perdrait en recréant l'index.
  //
  // C'est pourquoi `src/lib/migrations-contraintes.test.ts` la vérifie dans le
  // SQL, ET vérifie qu'aucune migration ultérieure ne la retire.
  @@unique([etablissementId, obligationId, equipementId, salarieId])
  @@index([etablissementId, datePrevue])
  @@index([salarieId])
  @@index([equipementId])
  @@index([statut])
  @@index([prescriptionId])
}

// ---------------------------------------------------------------------------
// Prescriptions particulières propres à un établissement — ADR-014
// ---------------------------------------------------------------------------

/// Acte à l'origine de la prescription. Le PV de commission est une pièce
/// (avis, CCH R. 143-27) ; l'arrêté du maire ou du préfet est l'acte qui
/// prescrit (CCH R. 143-45, R. 143-41 1°).
///
/// `demande_assureur` est la seule qui ne soit pas un acte d'autorité : elle
/// est contractuelle (ADR-032, qui amende l'ADR-014). Une échéance qui en naît
/// est marquée partout où elle s'affiche et ne reçoit jamais de référence
/// légale. La distinction se lit par `estSourceContractuelle()`
/// (`src/lib/prescriptions/schema.ts`), jamais en réénumérant les valeurs
/// dans chaque écran.
enum SourcePrescription {
  arrete_prefectoral
  arrete_municipal
  pv_commission_securite
  arrete_icpe
  inspection_travail
  demande_assureur
  autre
}

enum EffetPrescription {
  renforce_periodicite
  obligation_sur_mesure
}

model PrescriptionParticuliere {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  source       SourcePrescription
  effet        EffetPrescription
  reference    String
  autorite     String?
  /// Date de l'acte — date civile (ADR-011).
  dateDocument DateTime
  /// Date à laquelle la prescription cesse de produire effet (levée,
  /// abrogation). Conservée pour l'historique, jamais supprimée.
  dateFin      DateTime?
  actif        Boolean            @default(true)

  // Effet `renforce_periodicite` : obligation du référentiel ciblée.
  // Effet `obligation_sur_mesure` : libellé, réalisateurs, catégorie.
  // XOR garanti par la CHECK `PrescriptionParticuliere_effet_xor`.
  obligationId        String?
  libelle             String?
  description         String?
  periodicite         Periodicite
  realisateurRequis   Realisateur[]
  categorieEquipement CategorieEquipement?
  equipementId        String?
  equipement          Equipement?          @relation(fields: [equipementId], references: [id], onDelete: SetNull)

  verifications Verification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([etablissementId, actif])
  @@index([equipementId])
}

enum StatutVerification {
  a_planifier
  planifiee
  realisee_conforme
  realisee_observations
  realisee_ecart_majeur
  depassee
}

enum Periodicite {
  hebdomadaire
  bimensuelle
  mensuelle
  six_semaines
  trimestrielle
  semestrielle
  annuelle
  biennale
  triennale
  quadriennale
  quinquennale
  decennale
  mise_en_service_uniquement
  autre
}

enum Realisateur {
  organisme_agree
  organisme_accredite
  personne_qualifiee
  personne_competente
  exploitant
  fabricant
  bureau_controle
  // Le médecin du travail. `R. 4624-28` lui réserve le renouvellement du suivi
  // individuel renforcé, et `R. 4323-56` la délivrance de l'attestation
  // d'absence de contre-indication à la conduite. Aucune valeur ne le disait :
  // le repli était `exploitant`, qui annonce au dirigeant qu'il réalise
  // lui-même un acte qu'il lui est interdit de réaliser (lot 7).
  medecin_travail
  // « L'un des professionnels de santé mentionnés au premier alinéa de
  // l'article L. 4624-1 » — médecin du travail, collaborateur médecin, interne,
  // infirmier de santé au travail. C'est la formule de `R. 4624-10` (visite
  // d'information et de prévention) et de la visite intermédiaire du SIR, là où
  // le renouvellement du SIR exige le médecin. Les confondre resserrerait la
  // VIP au-delà de ce que le Code impose (lot 7).
  professionnel_sante_travail
  // L'équipe pluridisciplinaire d'un service de prévention et de santé au
  // travail interentreprises. `R. 4624-46` la distingue du médecin du travail,
  // et c'est le cas ordinaire de la cible du produit : une TPE adhère à un
  // service interentreprises, elle ne salarie pas de médecin (lot 8).
  equipe_pluridisciplinaire
}

model RapportVerification {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  verificationId  String
  verification    Verification  @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  dateRapport    DateTime
  organismeVerif String?
  resultat       ResultatVerification
  commentaires   String?

  fichierCle         String
  fichierNomOriginal String
  fichierMime        String
  fichierTaille      Int

  createdAt DateTime @default(now())

  @@index([etablissementId, dateRapport])
  @@index([verificationId])
}

enum ResultatVerification {
  conforme
  observations_mineures
  ecart_majeur
  non_verifiable
}

// ----------------------------------------------------------------------------
// Action unifiée — ADR-002
// Remplace l'ancien modèle `Mesure`.
//
// ⚠ INVARIANT NON REPRÉSENTABLE EN PRISMA SCHEMA ⚠
// Une action a exactement une origine : soit un risque du DUERP, soit une
// vérification réglementaire, jamais les deux, jamais aucune. Cet invariant est
// porté par une CHECK constraint SQL nommée `Action_origine_xor` :
//
//     CHECK (("risqueId" IS NULL) <> ("verificationId" IS NULL))
//
// déclarée dans prisma/migrations/20260421140000_v2_etablissement_et_conformite.
// Le langage Prisma ne sait pas exprimer un CHECK : la contrainte est donc
// invisible ici et n'existe QUE dans les fichiers de migration. Conséquence
// pratique : un `prisma db push` (dev, CI) recrée la table SANS le CHECK.
// Sur ces bases-là, l'invariant n'est garanti que par le code applicatif.
//
// Règle : ne jamais recréer la table `Action` sans réappliquer ce CHECK, et
// ne jamais utiliser `db push` comme substitut de `migrate deploy` sur une base
// qui doit refléter la production. Un test de non-régression
// (src/lib/migrations-contraintes.test.ts) relit les migrations et échoue si la
// contrainte disparaît du SQL.
// ----------------------------------------------------------------------------

model Action {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  risqueId       String?
  risque         Risque?       @relation(fields: [risqueId], references: [id], onDelete: Cascade)
  verificationId String?
  verification   Verification? @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  referentielMesureId String?

  libelle     String
  description String?
  type        TypeAction
  statut      StatutAction @default(ouverte)
  // Échelle [1, 5] — celle de l'écart à corriger, la même que
  // `ObligationConformite.criticite` du référentiel (« 1 = informatif,
  // 5 = vital »). **Ce n'est PAS `Risque.criticite`**, qui vaut
  // (gravité × probabilité) / maîtrise sur [1, 16] et s'écrit « 05/16 » à
  // l'écran. Les deux colonnes portent le même nom et aucune n'est bornée par
  // la base ; un seed a recopié l'une dans l'autre jusqu'au 2026-09-04 et la
  // fiche de l'action affichait « 6 sur 5 ». La borne vit dans
  // `lib/actions/schema.ts` (`CRITICITE_ACTION_MAX`), qui la fait respecter par
  // les deux seuls écrivains de production et la donne à l'affichage.
  criticite   Int?
  echeance    DateTime?
  responsable String?

  leveeLe          DateTime?
  leveeCommentaire String?
  leveeRapportId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([risqueId, referentielMesureId])
  @@index([etablissementId, statut])
  @@index([verificationId])
}

// Valeurs snake_case pour préserver la compatibilité avec les snapshots JSON
// et le code TS existant (cf. lib/referentiels/types.ts TypeMesure).
enum TypeAction {
  suppression
  reduction_source
  protection_collective
  protection_individuelle
  formation
  organisationnelle
}

enum StatutAction {
  ouverte
  en_cours
  levee
  abandonnee
}

// ----------------------------------------------------------------------------
// Annuaire prestataires — ADR-007
// Matérialise l'obligation de vigilance (art. L8222-1 / D8222-5 CT) :
// alertes d'expiration URSSAF (6 mois), RC Pro, Kbis, au-delà du simple
// carnet d'adresses.
// ----------------------------------------------------------------------------

model Prestataire {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  // Identité
  raisonSociale     String
  siret             String?
  estOrganismeAgree Boolean              @default(false)
  domaines          DomainePrestataire[]

  // Contact principal
  contactNom       String
  contactEmail     String
  contactTelephone String?

  // Vigilance L8222-1 — attestation URSSAF (à renouveler tous les 6 mois)
  attestationUrssafCle           String?
  attestationUrssafNom           String?
  attestationUrssafValableJusquA DateTime?

  // Assurance Responsabilité Civile Professionnelle
  assuranceRcProCle           String?
  assuranceRcProNom           String?
  assuranceRcProValableJusquA DateTime?

  // Extrait Kbis / justificatif d'immatriculation
  kbisCle          String?
  kbisNom          String?
  kbisDateEmission DateTime?

  notesInternes String?

  // Objets qui référencent ce prestataire. Ces relations sont en SetNull :
  // retirer un prestataire de l'annuaire ne doit jamais effacer un permis de
  // feu ou un plan de prévention — ce sont des pièces de traçabilité. Elles
  // conservent leur snapshot texte (prestataireRaison, entrepriseExterieureRaison)
  // et perdent seulement le lien vers la fiche.
  permisFeu       PermisFeu[]
  plansPrevention PlanPrevention[]
  accessTokens    AccessToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un même SIRET ne peut pas être saisi deux fois dans l'annuaire d'un même
  // établissement — c'est le doublon qui casse le suivi de vigilance (deux
  // fiches, deux attestations URSSAF, une seule à jour). Les NULL restent
  // distincts pour Postgres : les prestataires sans SIRET connu ne sont pas
  // contraints.
  @@unique([etablissementId, siret])
  @@index([etablissementId])
  @@index([etablissementId, raisonSociale])
}

enum DomainePrestataire {
  electricite
  incendie
  ascenseur
  porte_automatique
  ventilation_vmc
  cuisson_hotte
  equipement_pression
  levage
  stockage_dangereux
  // Contrôle d'étanchéité des fluides frigorigènes. Le domaine d'obligation
  // `froid` existait sans aucune contrepartie ici — et c'est précisément
  // l'obligation qui exige un opérateur CERTIFIÉ (attestation de capacité,
  // règlement (UE) 2024/573). Le produit savait donc dire « il vous faut un
  // opérateur certifié » et ne savait pas dire lequel, ni constater qu'aucun
  // n'était déclaré. Le trou est resté invisible parce que rien n'obligeait
  // les deux vocabulaires à se correspondre ; c'est désormais le cas
  // (`prestataires/domaines.ts`, ADR-024).
  froid
  carnet_sanitaire
  bureau_controle
  entretien_general
  travaux_btp
  nettoyage
  // Les deux domaines de prestataire du lot 7. Les trois domaines d'obligation
  // qu'il ajoute — formation à la sécurité, santé au travail, premiers secours
  // — n'appellent aucun vérificateur d'équipement, et `DOMAINES_PRESTATAIRE_ATTENDUS`
  // exige une contrepartie NON VIDE pour chaque domaine d'obligation. `autre`
  // aurait compilé, et aurait rétabli le silence que ce Record existe pour
  // corriger (cf. le précédent `froid`).
  organisme_formation
  service_sante_travail
  autre
}

// ----------------------------------------------------------------------------
// Signature électronique horodatée — ADR-006
// Niveau eIDAS « simple ». Preuve par : identité (compte ou OTP email) +
// hash SHA-256 du document + horodatage serveur + IP/UA.
// ----------------------------------------------------------------------------

model Signature {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  objetType ObjetSignable
  objetId   String

  signataireNom   String
  signataireEmail String
  signataireRole  String?
  userId          String? @db.Uuid // non-null si compte_connecte

  hashDocument String // SHA-256 hex (64 car.)
  nomDocument  String?

  methode   MethodeSignature
  ipAddress String?
  userAgent String?

  horodatageIso           DateTime @default(now())
  horodatageQualifieToken String?

  createdAt DateTime @default(now())

  @@index([etablissementId, objetType, objetId])
  @@index([userId])
}

enum ObjetSignable {
  rapport_verification
  permis_feu
  plan_prevention
  registre_accessibilite
  duerp_version
}

enum MethodeSignature {
  compte_connecte
  otp_email
}

// ----------------------------------------------------------------------------
// Accès externe par token — ADR-007
// Permet à un prestataire sans compte de consulter, déposer un rapport ou
// signer via un lien magique. Token clair envoyé par email, hash stocké.
// ----------------------------------------------------------------------------

model AccessToken {
  id        String @id @default(cuid())
  tokenHash String @unique

  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  scope         ScopeAccessToken
  objetType     String
  objetId       String
  prestataireId String?
  prestataire   Prestataire?     @relation(fields: [prestataireId], references: [id], onDelete: SetNull)

  emailDestinataire String
  nomDestinataire   String?

  otpHash           String?
  otpEssaisRestants Int       @default(3)
  // Expiration propre au code OTP, distincte de `expireLe` qui borne la durée
  // de vie du lien magique (72 h à 7 jours). Sans cette colonne, l'OTP restait
  // valable aussi longtemps que le lien, alors que lib/signatures/otp.ts fixe
  // OTP_TTL_MINUTES = 10 et que l'email annonce « Valable 10 minutes ».
  // Nullable : un token de scope `consultation` n'exige pas forcément d'OTP,
  // et un OTP non encore émis n'a pas de date d'expiration.
  otpExpireLe       DateTime?

  expireLe     DateTime
  utiliseLe    DateTime?
  revoqueLe    DateTime?
  revoqueMotif String?

  createdByUserId              String   @db.Uuid
  createdAt                    DateTime @default(now())
  derniereUtilisationIp        String?
  derniereUtilisationUserAgent String?

  @@index([etablissementId])
  @@index([objetType, objetId])
}

enum ScopeAccessToken {
  signature
  depot_rapport
  consultation
}

// ----------------------------------------------------------------------------
// Registre d'accessibilité ERP — art. R. 164-6 CCH, arrêté du 19 avril 2017.
// (R. 111-19-60 avant la recodification du 1er juillet 2021. « D111-19-33 »,
// cité ici jusqu'au 2026-08-28, ne désigne aucun article du CCH : la coquille
// vise R. 111-19-33, qui portait l'attestation d'accessibilité — pas le
// registre — et que le décret 2021-872 a abrogé.)
// Tout ERP doit tenir un registre public consultable sur place ou en ligne,
// qui décrit : (1) prestations fournies, (2) pièces administratives et
// techniques relatives à l'accessibilité, (3) formations du personnel
// d'accueil, (4) modalités de maintenance des équipements.
// ----------------------------------------------------------------------------

model RegistreAccessibilite {
  id              String        @id @default(cuid())
  etablissementId String        @unique
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  // Slug public stable — pose du QR code. Inchangé une fois publié.
  slugPublic String @unique

  // Étape 1 — Prestations fournies
  prestationsFournies String?              @db.Text
  handicapsAccueillis HandicapAccessible[]
  servicesAdaptes     String?              @db.Text

  // Étape 2 — Pièces administratives et techniques
  conformiteRegime        RegimeConformiteErp?
  dateConformite          DateTime?
  numeroAttestationAccess String?
  attestationCle          String?
  attestationNom          String?
  dateDepotAdap           DateTime? // Agenda d'accessibilité programmée
  agendaAdapCle           String?
  agendaAdapNom           String?

  // Étape 3 — Formation personnel d'accueil
  personnelForme          Boolean   @default(false)
  dateDerniereFormation   DateTime?
  organismeFormation      String?
  attestationFormationCle String?
  attestationFormationNom String?
  effectifForme           Int?

  // Étape 4 — Maintenance des équipements d'accessibilité
  equipementsAccessibilite   String?   @db.Text
  modalitesMaintenance       String?   @db.Text
  dernierControleMaintenance DateTime?

  // Publication
  publie   Boolean   @default(false)
  publieLe DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Pas d'index sur slugPublic : le @unique du champ en crée déjà un, et un
  // second index sur la même colonne ne fait que coûter à l'écriture.
}

// Les familles de handicap dans lesquelles un ERP déclare être adapté.
//
// LA SOURCE N'EST PAS LE DROIT DE L'ACCESSIBILITÉ, et c'est le résultat du
// relevé du 2026-09-03. Toute la chaîne a été ouverte — `L. 161-1` et
// `L. 164-1` du CCH, `R. 164-6` qui institue le registre, l'arrêté du
// 19 avril 2017 qui en fixe le contenu — et aucun de ces textes ne répartit
// les personnes handicapées : ils disent « quel que soit le handicap ». La
// seule énumération du droit français est `L. 114` du code de l'action sociale
// et des familles, écrit par l'article 2 de la loi du 11 février 2005 : cinq
// familles de fonctions — physiques, sensorielles, mentales, cognitives,
// psychiques — plus DEUX situations que l'article met sur le même plan.
//
// Ces deux-là manquaient, et c'est le défaut de type `J` : un établissement
// adapté au polyhandicap ne pouvait pas le déclarer. Ajoutées le 2026-09-03.
//
// Les six premières valeurs ne sont pas les mots de `L. 114` : elles en
// affinent deux — `moteur` pour « physiques », `visuel` et `auditif` pour
// « sensorielles ». Cet affinage est DÉCLARÉ, valeur par valeur, dans
// `FAMILLE_L114` (`src/lib/accessibilite/schema.ts`), et
// `handicap-accessible.test.ts` exige que chaque famille du texte y ait au
// moins un répondant. Voir `corpus/accessibilite-handicap.ts`.
enum HandicapAccessible {
  moteur
  visuel
  auditif
  mental
  cognitif
  psychique
  // « d'un polyhandicap ou d'un trouble de santé invalidant » — la fin de
  // `L. 114`, que les six valeurs ci-dessus ne savaient pas dire.
  polyhandicap
  trouble_sante_invalidant
}

enum RegimeConformiteErp {
  conforme_origine // Bâtiment neuf ou conforme dès la conception
  conforme_apres_travaux // Mise en conformité déjà réalisée
  derogation_accordee // Dérogation préfectorale (art. L. 165-1 CASF)
  adap_en_cours // Agenda d'accessibilité programmée validé
  non_conforme_sans_adap // Hors conformité sans plan actif
}

// ----------------------------------------------------------------------------
// Permis de feu — art. R. 4224-17 CT, recommandation INRS ED 6030, et en ERP
// l'art. GN 13 (« Travaux dangereux »), qui interdit le chantier dangereux en
// présence du public. Ce document n'est imposé sous ce nom par aucun texte : il
// matérialise un faisceau d'obligations. « MS 52 ERP », cité ici jusqu'au
// 2026-08-28, s'intitule « Présence de l'exploitant » et ne dit rien des
// travaux. La règle APSAD R43 est un référentiel de la profession de
// l'assurance, opposable par un contrat et non par le droit.
// ----------------------------------------------------------------------------

model PermisFeu {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  // Numérotation auto par établissement (pour traçabilité)
  numero Int

  // Qui intervient — soit prestataire de l'annuaire (FK), soit saisie libre.
  // SetNull : la suppression d'une fiche prestataire ne doit pas emporter le
  // permis, qui reste opposable ; le snapshot texte ci-dessous suffit à savoir
  // qui est intervenu.
  prestataireId      String?
  prestataire        Prestataire? @relation(fields: [prestataireId], references: [id], onDelete: SetNull)
  prestataireRaison  String // snapshot pour affichage
  prestataireContact String // nom du technicien
  prestataireEmail   String

  // Donneur d'ordre (côté donneur) — snapshot nom saisi
  donneurOrdreNom      String
  donneurOrdreFonction String?

  // Travaux
  dateDebut          DateTime
  dateFin            DateTime
  lieu               String // description précise : salle, étage, zone
  batimentId         String? // ADR-019 : le bâtiment ; `lieu` reste la précision
  batiment           Batiment?                 @relation(fields: [batimentId], references: [id], onDelete: SetNull)
  naturesTravaux     NatureTravauxPointChaud[]
  descriptionTravaux String

  // Checklist mesures préventives (ID du référentiel INRS ED 6030)
  mesuresValidees String[] @default([])
  mesuresNotes    String?

  // Surveillance post-travaux (2h standard INRS, 4h si risque élevé)
  dureeSurveillanceMinutes Int @default(120)

  // Cycle de vie
  statut StatutPermisFeu @default(brouillon)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([etablissementId, numero])
  @@index([etablissementId, dateDebut])
  @@index([statut])
  @@index([batimentId])
}

enum NatureTravauxPointChaud {
  soudage_arc
  soudage_gaz
  soudage_oxyacetylenique
  decoupe_plasma
  brasage
  meulage
  tronconnage
  chalumeau
  travaux_etancheite
  decapage_thermique
  autre
}

enum StatutPermisFeu {
  brouillon
  attente_signatures
  valide
  en_cours
  termine
  annule
}

// ----------------------------------------------------------------------------
// Plan de prévention — art. R. 4512-6 à R. 4512-12 du code du travail.
// (Le décret 92-158 a créé les art. R. 237-1 à R. 237-28 du code du travail ;
// ce sont eux que le décret 2008-244 a abrogés au 1er mai 2008 en les
// recodifiant en R. 4511-* / R. 4512-*. La fiche du décret 92-158 reste
// affichée « en vigueur » : c'est un texte modificateur, l'abrogation se lit
// sur les articles du code — « Abrogé par Décret n°2008-244 du 7 mars 2008 -
// art. 9 (V) » sur R. 237-1 —, pas sur lui. La filiation se dit, la source
// non.)
// Obligatoire en écrit si :
//   - durée totale ≥ 400 h sur 12 mois des travaux d'entreprise(s)
//     extérieure(s) — R. 4512-7 dit « égal au moins à 400 heures », OU
//   - figure sur la liste de travaux dangereux de l'arrêté du 19 mars 1993.
// Inspection commune préalable obligatoire — art. R. 4512-2, et non
// R. 4512-7 comme écrit ici jusqu'au 2026-08-28 : R. 4512-6 institue le plan,
// R. 4512-7 pose les deux cas qui imposent l'écrit (dont le seuil ci-dessus),
// R. 4512-8 en fixe le contenu. L'inspection est ailleurs, et elle est due
// quelle que soit la durée.
// ----------------------------------------------------------------------------

model PlanPrevention {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  numero Int

  // Entreprise extérieure — SetNull pour les mêmes raisons que PermisFeu :
  // le plan de prévention est une pièce de traçabilité, il survit au retrait
  // du prestataire de l'annuaire.
  prestataireId              String?
  prestataire                Prestataire? @relation(fields: [prestataireId], references: [id], onDelete: SetNull)
  entrepriseExterieureRaison String
  entrepriseExterieureSiret  String?
  efChefNom                  String // chef de l'entreprise extérieure
  efChefEmail                String
  efEffectifIntervenant      Int

  // Entreprise utilisatrice (vous)
  euChefNom      String
  euChefFonction String?

  // Travaux
  dateDebut          DateTime
  dateFin            DateTime
  dureeHeuresEstimee Int?
  lieux              String // multi-lieux possibles, texte libre
  batimentId         String? // ADR-019 : rattachement principal ; `lieux` garde le détail
  batiment           Batiment? @relation(fields: [batimentId], references: [id], onDelete: SetNull)
  naturesTravaux     String    @db.Text
  travauxDangereux   Boolean   @default(false)

  // Inspection commune préalable (art. R. 4512-2 — c'est lui qui l'impose ;
  // R. 4512-7 ne porte que le seuil de l'écrit. Relu à la source le 2026-09-02.)
  inspectionDate         DateTime?
  inspectionParticipants String?   @db.Text

  // Lignes risques-mesures (relation 1-N)
  lignes LignePlanPrevention[]

  // Cycle de vie
  statut StatutPlanPrevention @default(brouillon)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([etablissementId, numero])
  @@index([etablissementId, dateDebut])
  @@index([batimentId])
}

model LignePlanPrevention {
  id               String         @id @default(cuid())
  planPreventionId String
  plan             PlanPrevention @relation(fields: [planPreventionId], references: [id], onDelete: Cascade)

  ordre                        Int     @default(0)
  risque                       String
  mesureEntrepriseUtilisatrice String?
  mesureEntrepriseExterieure   String?

  @@index([planPreventionId, ordre])
}

enum StatutPlanPrevention {
  brouillon
  inspection_faite
  attente_signatures
  valide
  clos
  annule
}

// ----------------------------------------------------------------------------
// Carnet sanitaire eau — arrêté du 1er février 2010 (légionelles),
// art. R1321-23 Code de la santé publique. Applicable aux ERP avec ECS,
// habitat collectif, restauration. Contenu imposé :
//   - description des installations (points de puisage)
//   - relevés de température ECS (hebdo minimum, seuil ≥ 50°C)
//   - analyses de légionelles (annuel, seuil d'action 1000 UFC/L)
// ----------------------------------------------------------------------------

model CarnetSanitaire {
  id              String        @id @default(cuid())
  etablissementId String        @unique
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  descriptionReseau String?

  pointsReleve PointReleve[]
  analyses     AnalyseLegionelle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PointReleve {
  id       String          @id @default(cuid())
  carnetId String
  carnet   CarnetSanitaire @relation(fields: [carnetId], references: [id], onDelete: Cascade)

  nom             String
  localisation    String?
  batimentId      String?
  batiment        Batiment?     @relation(fields: [batimentId], references: [id], onDelete: SetNull)
  typeReseau      TypeReseauEau
  seuilMinCelsius Float         @default(50)
  actif           Boolean       @default(true)

  releves ReleveTemperature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carnetId])
  @@index([batimentId])
}

model ReleveTemperature {
  id            String      @id @default(cuid())
  pointReleveId String
  pointReleve   PointReleve @relation(fields: [pointReleveId], references: [id], onDelete: Cascade)

  dateReleve         DateTime
  temperatureCelsius Float
  conforme           Boolean
  operateur          String?
  commentaire        String?

  createdAt DateTime @default(now())

  @@index([pointReleveId, dateReleve])
}

model AnalyseLegionelle {
  id       String          @id @default(cuid())
  carnetId String
  carnet   CarnetSanitaire @relation(fields: [carnetId], references: [id], onDelete: Cascade)

  dateAnalyse   DateTime
  laboratoire   String?
  valeurUfcParL Int?
  conforme      Boolean
  rapportCle    String?
  rapportNom    String?
  commentaire   String?

  createdAt DateTime @default(now())

  @@index([carnetId, dateAnalyse])
}

enum TypeReseauEau {
  ECS
  EFS
  ECS_BOUCLAGE
}

// ----------------------------------------------------------------------------
// ⚠️ Modèles orphelins — le module Interventions a été retiré du produit
// (ADR-018). Plus aucun code applicatif ne les lit ni ne les écrit ; ils
// restent ici le temps de trancher la suppression, qui fera l'objet d'une
// migration dédiée. Ne rien y brancher de neuf.
//
// Interventions / tickets — gestion du quotidien (art. R4224-17 CT :
// obligation de maintien en état de conformité). Pas de forme imposée,
// mais la traçabilité est ce que l'inspecteur demande en premier.
//
// Différenciateur : quand un ticket concerne un équipement ou un risque
// du DUERP, il peut être lié — et sa clôture déclenche la réévaluation
// du risque associé.
// ----------------------------------------------------------------------------

model Intervention {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  numero Int

  titre       String
  description String?
  photos      String[] @default([]) // keys FileStorage

  priorite     PrioriteIntervention @default(moyenne)
  statut       StatutIntervention   @default(ouvert)
  localisation String?

  // Liens optionnels
  uniteTravailId String?
  // ADR-009 — boucle ticket ↔ DUERP. Vraie clé étrangère en SetNull : jusqu'ici
  // la colonne était seulement indexée, si bien que supprimer une unité de
  // travail (cascade sur ses risques) laissait des tickets pointant dans le
  // vide. SetNull plutôt que Cascade : le ticket décrit un fait réel survenu
  // sur le terrain, il doit survivre à la réorganisation du DUERP.
  risqueId       String?
  risque         Risque? @relation(fields: [risqueId], references: [id], onDelete: SetNull)
  prestataireId  String?

  // Cycle de vie
  creeParUserId String    @db.Uuid
  assigneA      String? // nom du responsable (interne ou externe)
  echeance      DateTime?
  dateCloture   DateTime?
  motifCloture  String?

  commentaires CommentaireIntervention[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([etablissementId, numero])
  @@index([etablissementId, statut])
  @@index([etablissementId, priorite, statut])
  @@index([risqueId])
}

model CommentaireIntervention {
  id             String       @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  auteurNom String
  contenu   String

  createdAt DateTime @default(now())

  @@index([interventionId])
}

enum PrioriteIntervention {
  basse
  moyenne
  urgente
  bloquante
}

enum StatutIntervention {
  ouvert
  assigne
  en_cours
  fait
  annule
}

// ----------------------------------------------------------------------------
// Fiches du registre de sécurité à saisie libre
//
// Le registre compte une quarantaine de fiches. La plupart sont déjà remplies
// par un modèle métier — les équipements pour l'inventaire, les rapports pour
// les vérifications. Restent celles qui ne font que poser des questions et
// ranger des réponses : téléphones utiles, état nominatif du personnel de
// sécurité, contrôles administratifs, événements, dépoussiérage.
//
// Leur donner un modèle chacune serait huit tables pour une seule mécanique.
// Elles partagent donc celle-ci, et ce sont les **questions** qui varient —
// décrites en TypeScript versionné (`src/lib/registre/champs.ts`), au même
// titre que le référentiel d'obligations (ADR-003). Une question posée à un
// dirigeant se relit ainsi dans l'historique Git.
//
// `sectionId` désigne une fiche du catalogue (`src/lib/registre/sections.ts`).
// Ce n'est volontairement pas une clé étrangère : le catalogue n'est pas en
// base. La contrepartie est qu'un identifiant renommé orphelinerait des
// réponses — d'où le test qui vérifie que tout `sectionId` écrit existe au
// catalogue, sur le modèle du suivi de `referentielVersion`.
//
// `contenu` porte l'une des deux formes de saisie :
//   - formulaire : { "champs": { "<cle>": "<valeur>", … } }
//   - journal    : { "lignes": [ { "<cle>": "<valeur>", … }, … ] }
// La forme n'est pas contrainte en base — c'est Zod qui la valide à l'écriture,
// à partir du catalogue. Une CHECK ne saurait pas exprimer une forme qui
// dépend d'un fichier TypeScript.
// ----------------------------------------------------------------------------

model FicheRegistre {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  sectionId String
  contenu   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Une fiche par section et par établissement : la saisie est un upsert, pas
  // un empilement de brouillons.
  @@unique([etablissementId, sectionId])
  @@index([etablissementId])
}

// -----------------------------------------------------------------------------
// Personnel (ADR-023)
// -----------------------------------------------------------------------------

/// Un salarié suivi, pour ses seuls titres de santé-sécurité.
///
/// Ce n'est PAS un fichier du personnel. Les champs absents sont aussi décidés
/// que les champs présents : ni date de naissance, ni NIR, ni adresse, ni
/// coordonnées privées, ni rémunération. Aucune obligation de santé-sécurité
/// n'en a besoin, et les collecter « au cas où » changerait la nature du
/// produit et sa surface de risque (docs/rgpd.md § 2.2).
///
/// Base légale du traitement : obligation légale de l'employeur, RGPD 6.1.c —
/// jamais le consentement, qui n'est pas libre en situation de subordination.
model Salarie {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  nom    String
  prenom String
  /// Poste ou fonction, en texte libre. Sert à comprendre quels titres sont
  /// pertinents ; ne déclenche rien automatiquement — le moteur ne sait pas
  /// déduire une activité d'un intitulé de poste (ADR-023 § 1 bis).
  poste  String?

  /// Date d'entrée dans l'effectif. Point de départ des obligations « à
  /// l'embauche ». Sans elle, une telle obligation n'aurait d'autre départ que
  /// le jour de la saisie, c'est-à-dire un retard inventé.
  entreLe DateTime?

  /// Désactivé plutôt que supprimé quand la personne quitte l'entreprise : la
  /// preuve qu'elle était habilitée AU MOMENT où elle a opéré doit survivre à
  /// son départ, c'est elle qui couvre l'employeur sur une période passée
  /// (docs/rgpd.md § 4.3).
  actif Boolean @default(true)

  titres    TitreSalarie[]
  echeances Verification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([etablissementId, actif])
}

/// Un titre détenu par un salarié : l'habilitation, l'attestation, le CACES.
///
/// C'est une DÉCLARATION de l'employeur, pas une dérivation du moteur
/// (ADR-023 § 1 bis) : rien dans le modèle ne dit qu'une personne opère sur des
/// installations électriques, et l'appliquer à tout l'effectif serait un faux
/// positif de masse. L'employeur seul sait qui fait quoi.
///
/// Elle est durable, et distincte du calendrier : les lignes de `Verification`
/// se régénèrent, cette déclaration non. C'est elle qui les fait naître.
model TitreSalarie {
  id        String  @id @default(cuid())
  salarieId String
  salarie   Salarie @relation(fields: [salarieId], references: [id], onDelete: Cascade)

  /// L'identifiant de l'obligation du référentiel (ADR-003) dont ce titre est
  /// l'instance. Pas de clé étrangère : le référentiel vit en TypeScript.
  obligationId String

  /// Date de délivrance du titre.
  delivreLe DateTime

  /// Échéance, quand elle est connue ou calculable. `null` = titre sans terme
  /// écrit dans un texte — l'habilitation électrique en est le cas type, le
  /// Code renvoyant à des modalités qu'il qualifie lui-même de recommandées
  /// (ADR-023 § 6).
  echeanceLe DateTime?

  /// Note libre de l'employeur (organisme, niveau d'habilitation).
  /// JAMAIS un élément médical : le motif, le diagnostic et la pièce restent
  /// hors de l'outil (docs/rgpd.md § 2.3).
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Un salarié ne détient qu'une fois le même titre. Le renouvellement met à
  /// jour les dates, il ne crée pas une seconde ligne — sans quoi l'historique
  /// des titres se confondrait avec l'état courant.
  // Pas d'`@@index([salarieId])` : `salarieId` est la colonne de TÊTE de
  // l'index unique ci-dessus, qui sert donc déjà `WHERE salarieId = ?`. Un
  // second index ne serait jamais choisi et chaque écriture en paierait la
  // mise à jour — c'est le motif exact de la migration `index_redondant`,
  // écrite la veille pour en retirer un.
  @@unique([salarieId, obligationId])
}

/// Ce que l'employeur déclare avoir mis en place, quand aucune date n'est due.
///
/// L'ADR-022 nomme quatre natures d'obligation ; seule la première — l'échéance
/// récurrente — a un support de persistance, `Verification`. Les états
/// permanents n'en avaient aucun : trois lots ont dépouillé des textes et
/// encodé trente obligations que le générateur écarte à raison — sans
/// périodicité, pas de rendez-vous — et qu'aucun écran ne montrait.
///
/// POURQUOI PAS UNE `Verification` SANS DATE. C'est précisément ce que le
/// générateur refuse (`generateur.ts`, `estSansRendezVous`), et pour une bonne
/// raison : une `Verification` porte une échéance, donc une affirmation
/// datée. C'est ce qui l'oblige, quand son obligation quitte le référentiel, à
/// tout l'appareil `aArchiver` / `marquerNonApplicable` de la boucle finale du
/// générateur — une ligne orpheline qui porte une date ment. Une déclaration ne
/// porte aucune échéance : il n'y a rien à barrer.
///
/// CE MODÈLE N'EST PAS UNE PREUVE, ET LE PRODUIT NE DOIT PAS LES CONFONDRE
/// (ADR-027). Une ligne d'ici est une déclaration de l'employeur : ni un
/// rapport de vérification, ni une pièce, ni un constat du produit. Elle
/// n'allume rien ailleurs — ni le « % prêt » de Préparer un contrôle, ni un
/// indicateur au vert, ni une entrée du ZIP de contrôle.
model DeclarationEtatPermanent {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  /// L'identifiant de l'obligation du référentiel (ADR-003) que l'employeur
  /// déclare en place. Pas de clé étrangère : le référentiel vit en
  /// TypeScript, comme pour `TitreSalarie.obligationId`.
  ///
  /// Une déclaration dont l'obligation a quitté le référentiel n'est PAS
  /// supprimée : l'écran liste les obligations que le moteur rend et y joint
  /// les déclarations, jamais l'inverse — elle cesse donc simplement de
  /// s'afficher. La garder coûte une ligne et rend la déclaration si
  /// l'obligation revient.
  obligationId String

  /// Date de la DÉCLARATION, pas du fait déclaré. L'employeur affirme
  /// aujourd'hui que l'état est là ; le produit ne sait pas depuis quand, et
  /// ne le demande pas.
  ///
  /// Aucune relance n'en découle, sous aucune forme — pas même un badge « à
  /// revoir ». Aucun des textes concernés n'écrit de rythme : en poser un
  /// serait une périodicité inventée, ce que ce dépôt a déjà eu à retirer
  /// ailleurs. La date s'affiche, et le dirigeant juge lui-même.
  declareLe DateTime @default(now())

  /// Note libre de l'employeur — où l'affiche est posée, quel service a été
  /// choisi. Jamais un justificatif : cet écran n'ouvre aucune surface de
  /// dépôt (ADR-027).
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Un établissement ne déclare qu'une fois le même état. Décocher supprime
  /// la ligne, recocher en crée une neuve — l'historique des déclarations
  /// n'est pas tenu, et ne doit pas l'être : ce serait une trace qui
  /// ressemblerait à une preuve.
  ///
  /// Pas d'`@@index([etablissementId])` : c'est la colonne de TÊTE de l'index
  /// unique ci-dessus, qui sert donc déjà `WHERE etablissementId = ?`.
  @@unique([etablissementId, obligationId])
}
