# Variables de la pile locale CC (docker-compose.cc.yml). Copier en
# .env.cc-local (ignoré par git) et remplir. La base, le stockage et le pilote
# d'e-mail sont posés par le fichier compose.

# Better Auth (ADR-052) : 32 caractères au moins, propre à cette pile
# (`openssl rand -base64 32`).
BETTER_AUTH_SECRET=

# Ce que dit l'application d'elle-même : jamais « production » ici.
APP_ENV=preview
